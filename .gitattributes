# Auto detect text files and perform LF normalization
* text=auto eol=lf

# C / C++ sources and headers
*.c     text eol=lf
*.h     text eol=lf

# Build files & Docs
Makefile        text eol=lf
*.mk            text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.clang-format  text eol=lf
.editorconfig   text eol=lf

# Shell scripts
*.sh    text eol=lf

# Windows scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.bmp   binary
*.tga   binary
*.ttf   binary
*.otf   binary
*.ico   binary
